map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
# TLS terminates at the host reverse proxy; the container is loopback-bound.
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https https;
    http http;
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 100m;

    location = /frontend-healthz {
        access_log off;
        return 200 "ok\n";
    }
    location = /env-config.js {
        add_header Cache-Control "no-store" always;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
    # API endpoints from this fork, including SSE, OAuth, files and webhooks.
    location ~ ^/(graphql|metadata|rest|auth|client-config|file|public-assets|webhooks|s|mcp|oauth|\.well-known|open-api|healthz|cloudflare|app/billing|admin-panel)(/|$) {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend "${BACKEND_UPSTREAM}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location ~* \.(js|css|woff2?|ttf|ico|png|jpe?g|svg|webp|json|map)$ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
